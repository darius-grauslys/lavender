{
  "$schema": "https://opencode.ai/config.json",
  "model": "local/{env:LAV_LLM_MODEL}",
  "autoupdate": false,
  "share": "disabled",
  "provider": {
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Host LLM server",
      "options": {
        "baseURL": "http://{env:LAV_LLM_HOST}:{env:LAV_LLM_PORT}/v1"
      },
      "models": {
        "{env:LAV_LLM_MODEL}": {
          "name": "{env:LAV_LLM_MODEL}"
        }
      }
    }
  }
}
