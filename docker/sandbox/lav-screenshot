#!/usr/bin/env python3
"""Save a PNG of the sandbox's virtual display ($DISPLAY, run by Xvfb).

    lav-screenshot [OUT.png]          whole screen (default /tmp/screen.png)
    lav-screenshot --crop W H OUT.png top-left W x H only (SDL windows open
                                      at 0,0, so this is the game window)
"""
import argparse
import os

from PIL import ImageGrab

p = argparse.ArgumentParser(description=__doc__.splitlines()[0])
p.add_argument("out", nargs="?", default="/tmp/screen.png")
p.add_argument("--crop", nargs=2, type=int, metavar=("W", "H"))
a = p.parse_args()

im = ImageGrab.grab(xdisplay=os.environ.get("DISPLAY", ":99"))
if a.crop:
    im = im.crop((0, 0, *a.crop))
im.save(a.out)
print(f"{a.out} {im.size[0]}x{im.size[1]}")
