# Sandbox target: the throwaway test-issues project, for exercising the
# sandbox (MRs, issues) without touching the Lavender repo.
#   docker compose -f docker/sandbox/compose.yml --env-file docker/sandbox/test-issues.env up -d
COMPOSE_PROJECT_NAME=lav-sandbox-test-issues
GITLAB_HOST=git.graslocal.com
GITLAB_PROJECT_PATH=dgrauslys/test-issues
GITLAB_PROJECT_ID=10
# Developer-role project access token for test-issues (GITLAB_TOKEN=...).
GITLAB_TOKEN_FILE=${HOME}/.config/lavender/gitlab-test-issues.env
