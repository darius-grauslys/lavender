# Sandbox target: the Lavender repo itself.
#   docker compose -f docker/sandbox/compose.yml --env-file docker/sandbox/lavender.env up -d --build
COMPOSE_PROJECT_NAME=lav-sandbox-lavender
GITLAB_HOST=git.graslocal.com
GITLAB_PROJECT_PATH=dgrauslys/lavender
GITLAB_PROJECT_ID=6
# Developer-role project access token for this project (GITLAB_TOKEN=...).
GITLAB_TOKEN_FILE=${HOME}/.config/lavender/gitlab.env
