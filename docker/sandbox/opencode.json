{
  "$schema": "https://opencode.ai/config.json",
  "model": "local/{env:LAV_LLM_MODEL}",
  "autoupdate": false,
  "share": "disabled",
  "provider": {
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Host LLM server",
      "options": {
        "baseURL": "http://{env:LAV_LLM_HOST}:{env:LAV_LLM_PORT}/v1"
      },
      "models": {
        "{env:LAV_LLM_MODEL}": {
          "name": "{env:LAV_LLM_MODEL}",
          "limit": {
            "context": {env:LAV_LLM_CONTEXT},
            "output": {env:LAV_LLM_OUTPUT}
          },
          "variants": {
            "off": { "chat_template_kwargs": { "enable_thinking": false } },
            "low": { "thinking_budget_tokens": 1024 },
            "medium": { "thinking_budget_tokens": 4096 },
            "high": { "thinking_budget_tokens": 16384 }
          }
        }
      }
    }
  }
}
