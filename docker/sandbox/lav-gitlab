#!/usr/bin/env python3
"""lav-gitlab — open GitLab merge requests and issues from the sandbox.

No credentials live here. Requests go out through HTTPS_PROXY (iron-proxy),
which injects the PRIVATE-TOKEN header and only allows the endpoints listed
in docker/sandbox/iron-proxy.yaml.

There is no `git push` (the proxy refuses it). `mr` sends the committed
changes on the current branch, relative to origin/<target>, to GitLab's
commits API, which creates the branch server-side, and then opens a merge
request for it.

    lav-gitlab mr --branch agent/fix-foo --title "Fix foo" [--description ...]
    lav-gitlab issue --title "Foo is broken" [--description ...] [--labels a,b]

Env:
    GITLAB_URL         e.g. https://git.graslocal.com
    GITLAB_PROJECT_ID  numeric project id (6; must match iron-proxy.yaml)
"""

from __future__ import annotations

import argparse
import base64
import json
import os
import subprocess
import sys
import urllib.error
import urllib.request


def env(name: str) -> str:
    value = os.environ.get(name)
    if not value:
        sys.exit(f"lav-gitlab: {name} is not set")
    return value


def api(method: str, path: str, body: dict | None = None) -> dict:
    url = f"{env('GITLAB_URL').rstrip('/')}/api/v4/projects/{env('GITLAB_PROJECT_ID')}{path}"
    data = json.dumps(body).encode() if body is not None else None
    request = urllib.request.Request(url, data=data, method=method)
    request.add_header("Content-Type", "application/json")
    # Cloudflare in front of git.graslocal.com 403s the default Python-urllib UA.
    request.add_header("User-Agent", "lav-gitlab/1")
    try:
        with urllib.request.urlopen(request, timeout=60) as response:
            return json.load(response)
    except urllib.error.HTTPError as error:
        detail = error.read().decode(errors="replace")
        sys.exit(f"lav-gitlab: {method} {path} -> {error.code}\n{detail}")


def git(*args: str) -> str:
    return subprocess.run(
        ["git", *args], check=True, capture_output=True, text=True
    ).stdout


def file_content(path: str) -> str:
    with open(path, "rb") as f:
        return base64.b64encode(f.read()).decode()


def commit_actions(base_sha: str) -> list[dict]:
    """Translate `git diff base..HEAD` into commits-API actions."""
    actions = []
    diff = git("diff", "--name-status", "-M", "-z", base_sha, "HEAD").split("\0")
    fields = iter(field for field in diff if field)
    for status in fields:
        kind = status[0]
        if kind == "R":
            old_path, new_path = next(fields), next(fields)
            actions.append({"action": "move", "previous_path": old_path,
                            "file_path": new_path, "encoding": "base64",
                            "content": file_content(new_path)})
        elif kind in "AM":
            path = next(fields)
            actions.append({"action": "create" if kind == "A" else "update",
                            "file_path": path, "encoding": "base64",
                            "content": file_content(path)})
        elif kind == "D":
            actions.append({"action": "delete", "file_path": next(fields)})
        else:
            sys.exit(f"lav-gitlab: unsupported diff status {status!r}")
    return actions


def cmd_mr(args: argparse.Namespace) -> None:
    os.chdir(git("rev-parse", "--show-toplevel").strip())
    if git("status", "--porcelain", "--untracked-files=no").strip():
        sys.exit("lav-gitlab: commit your changes first (working tree is dirty)")
    if not args.target:
        args.target = api("GET", "")["default_branch"]

    # The base must already exist on GitLab: new files are applied on top of it.
    base_sha = git("merge-base", "HEAD", f"origin/{args.target}").strip()
    api("GET", f"/repository/commits/{base_sha}")

    actions = commit_actions(base_sha)
    if not actions:
        sys.exit(f"lav-gitlab: no committed changes since origin/{args.target}")

    message = args.message or git("log", "-1", "--format=%B").strip()
    commit = api("POST", "/repository/commits", {
        "branch": args.branch,
        "start_sha": base_sha,
        "commit_message": message,
        "actions": actions,
    })
    mr = api("POST", "/merge_requests", {
        "source_branch": args.branch,
        "target_branch": args.target,
        "title": args.title,
        "description": args.description,
        "remove_source_branch": True,
    })
    print(f"commit {commit['id']} on {args.branch} ({len(actions)} files)")
    print(mr["web_url"])


def cmd_issue(args: argparse.Namespace) -> None:
    issue = api("POST", "/issues", {
        "title": args.title,
        "description": args.description,
        "labels": args.labels,
    })
    print(issue["web_url"])


def main() -> None:
    parser = argparse.ArgumentParser(prog="lav-gitlab")
    sub = parser.add_subparsers(required=True)

    mr = sub.add_parser("mr", help="commit current branch to GitLab and open an MR")
    mr.add_argument("--branch", required=True, help="new branch name on GitLab")
    mr.add_argument("--title", required=True)
    mr.add_argument("--description", default="")
    mr.add_argument("--target", help="target branch (default: the project's default branch)")
    mr.add_argument("--message", help="commit message (default: last commit's)")
    mr.set_defaults(func=cmd_mr)

    issue = sub.add_parser("issue", help="open an issue")
    issue.add_argument("--title", required=True)
    issue.add_argument("--description", default="")
    issue.add_argument("--labels", default="", help="comma-separated")
    issue.set_defaults(func=cmd_issue)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
